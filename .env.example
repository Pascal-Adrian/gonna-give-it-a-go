# Personal access token.
# Asana > My Settings > Apps > Personal access tokens > Create new token.
ASANA_TOKEN=

# Workspace (or organization) to extract from.
# List yours with:
#   curl -H "Authorization: Bearer $ASANA_TOKEN" https://app.asana.com/api/1.0/workspaces
ASANA_WORKSPACE_ID=

# Where the extracted JSON is written. Optional, defaults to "out".
# Only "out" is covered by .gitignore; if you change this, add the new
# directory too -- the export contains user email addresses.
#ASANA_OUT_DIR=out

# How often each category is re-read. Optional.
# Users rarely change and carry no timestamps, so they are polled far less
# often than projects.
#ASANA_POLL_USERS=5m
#ASANA_POLL_PROJECTS=30s

# Requests per minute your plan allows -- 150 on the free tier, 1500 on paid.
# This is the plan's limit, not the rate issued: the client paces just under it.
# Careful not to paste a gid here.
#ASANA_RATE_LIMIT=150

# Log verbosity: debug, info, warn or error. Optional, defaults to info.
# Every poll is logged at info, including the ones that found nothing new;
# raise this to warn if that is too chatty.
#LOG_LEVEL=info
