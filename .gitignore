# ---- Go binaries & build output ----
# Compiled object files, shared libraries
*.o
*.a
*.so
*.dylib
*.dll

# Test binary built with `go test -c`
*.test

# Output of `go build` for a package named after the module dir
/gonna-give-it-a-go
# Common local build output directories
/bin/
/dist/
/build/

# Windows / macOS executables
*.exe
*.exe~
*.app

# ---- Go tooling ----
# Coverage & profiling
*.out
*.prof
coverage.txt
coverage.html
profile.cov

# Fuzzing corpus generated by `go test -fuzz`
testdata/fuzz/

# `go work` files are usually developer-local
go.work
go.work.sum

# Dependency directory (pre-modules / `go mod vendor` — uncomment if not committing vendor)
# vendor/

# Go module cache when GOPATH/GOMODCACHE is inside the repo
/pkg/
/.gocache/

# Delve debugger binaries
__debug_bin*
debug
debug.test

# golangci-lint cache
.golangci-lint-cache/

# air / reflex live-reload output
tmp/

# ---- Extracted data ----
# Asana exports contain user email addresses; never commit them.
out/

# ---- Secrets & local config ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
credentials.json
service-account*.json

# ---- Editors & IDEs ----
.idea/
*.iml
.vscode/
*.code-workspace
.fleet/
*.swp
*.swo
*~
.history/

# ---- Claude Code ----
.claude/
CLAUDE.local.md

# ---- OS cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Logs & temp ----
*.log
*.tmp
*.bak
*.orig
